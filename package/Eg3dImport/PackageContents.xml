    <!-- ========================================================
         2. MacroScript - die Oberflaeche.
         Landet unter Customize -> Customize User Interface ->
         Category "DH Tools" und laesst sich von dort auch auf
         eine Toolbar oder einen Shortcut legen.
         ======================================================== -->

    <Components Description="macroscripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2027" />

        <!-- Platzhalter statt Dateiname. Die Spezifikation erlaubt ihn
             ausdruecklich: "You can specify a wildcard in the file name,
             such as *.ms". Nur im DATEINAMEN, nicht im Pfad.

             Grund fuer den Platzhalter: eine Namensliste an zwei Stellen
             zu pflegen - hier und in INSTALLIERE.bat - geht genau einmal
             gut. In 0.1.0 stand in der .bat ein Name, den es nie gab
             (Eg3dImportAlt.mcr, uebernommen aus dem BAF-Vorbild); die
             Installation brach ab, obwohl alle zwoelf Plugins fertig
             waren.

             Achtung: "If a file is specified twice, 3ds Max will display
             an error message." Also NICHT zusaetzlich einzelne
             ComponentEntry-Zeilen fuer dieselben Dateien danebenstellen.

             Anders als bei den Plugins reicht hier EIN Block ueber den
             ganzen Bereich: ein Skript ist Text und hat keine
             Binaerkompatibilitaet, die brechen koennte. -->
        <ComponentEntry AppName="Eg3dImportUI" Version="0.4.0"
                        ModuleName="./Contents/MacroScripts/*.mcr"
                        AppDescription="Oberflaeche zum Importieren" />
    </Components>

    <!-- ========================================================
         3. Kein Menue mehr.

         Bis 1.0.1 lag hier ein Post-Start-Up-Skript, das ein
         eigenes "DH Tools" anlegte. Das ist entfallen: EG3D
         steht in Max' eigenem Dialog unter Datei -> Importieren,
         eingetragen von der SceneImport-Klasse im Plugin.

         Damit entfaellt auch der GUID-Konflikt, den ein
         gemeinsames Untermenue ab Max 2025 ausloest:
         CreateSubMenu LEGT dort AN und sucht nicht, zwei Pakete
         koennen sich ein Untermenue also nicht teilen.

         Nebeneffekt: der Konflikt ab Max 2025 ist damit weg.
         CreateSubMenu legt dort an und sucht nicht, zwei Pakete
         koennen sich ein Untermenue also nicht teilen - es
         entstanden zwei gleichnamige Eintraege nebeneinander.

         Das MacroScript oben bleibt registriert. Unter
         Customize -> Customize User Interface -> Kategorie
         "DH Tools" laesst es sich auf eine Toolbar oder einen
         Shortcut legen, wer das lieber mag.
         ======================================================== -->

</ApplicationPackage>
